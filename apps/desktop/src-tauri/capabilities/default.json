{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi minimi della finestra principale: ascolto degli eventi e solo i comandi del contratto IPC. Nessun accesso generico a file system, shell o rete.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-auth-status",
    "allow-auth-sign-in",
    "allow-auth-sign-out",
    "allow-secure-store-get",
    "allow-secure-store-set",
    "allow-secure-store-delete",
    "allow-list-local-projects",
    "allow-suggest-project-folder",
    "allow-check-folder",
    "allow-pick-folder",
    "allow-link-project",
    "allow-unlink-project",
    "allow-get-project-status",
    "allow-publish",
    "allow-sync-now",
    "allow-update-now",
    "allow-discard-changes",
    "allow-answer-stale-save",
    "allow-notify-remote-changed",
    "allow-get-publish-policy",
    "allow-set-publish-policy",
    "allow-list-versions",
    "allow-get-version",
    "allow-compare-versions",
    "allow-export-version",
    "allow-open-version-copy",
    "allow-restore-version",
    "allow-list-conflicts",
    "allow-get-conflict",
    "allow-open-conflict-copy",
    "allow-resolve-conflict",
    "allow-list-snapshots",
    "allow-export-snapshot",
    "allow-get-app-info",
    "allow-get-public-config",
    "allow-open-in-openrocket",
    "allow-open-folder",
    "allow-get-app-settings",
    "allow-set-app-settings",
    "allow-export-diagnostics",
    "allow-check-for-update",
    "allow-install-update",
    "allow-notify-desktop"
  ]
}
