# Segreti delle Edge Functions: SOLO i nomi, nessun valore. Si impostano con
#   supabase secrets set --env-file supabase/.env      (file locale NON versionato)
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono già forniti dal runtime delle Edge Functions su
# Supabase; servono qui solo per l'esecuzione locale.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App (vedi README: registrazione e permessi)
GITHUB_APP_ID=
# Chiave privata PEM scaricata dalla pagina dell'app (PKCS#1 o PKCS#8); a-capo come \n se su una riga.
GITHUB_APP_PRIVATE_KEY=
# Facoltativo: si ricava da GET /orgs/{org}/installation se assente.
# GITHUB_APP_INSTALLATION_ID=
# Organizzazione GitHub che ospita i repository dei progetti.
GITHUB_ORG=
# Segreto del webhook configurato sulla GitHub App (firma X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=
# Client ID / secret dell'app (rinnovo del token utente, funzione github-token-refresh).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Solo per `supabase start` in locale: OAuth di accesso con GitHub (config.toml [auth.external.github]).
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
